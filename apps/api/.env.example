PORT=3000
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
# Leave PROXY_HEADER empty unless a proxy really sets it. Fiber's c.IP() returns "" when the
# named header is absent, which breaks any limiter keyed on the client IP.
PROXY_HEADER=

DB_HOST=localhost
# Matches the host port in docker-compose.yml, which deliberately avoids 5432 so it does not
# collide with a Postgres already running on the developer's machine. Point this at 5432 instead
# if you are using your own local Postgres rather than the compose service.
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=landing
DB_SSLMODE=disable

# NOTIFY_DRIVER selects how a new lead is announced to the site owner: "log" (default) writes an
# slog line and needs no AWS account, "ses" sends real mail through Amazon SES. Load() refuses to
# start with NOTIFY_DRIVER=log when APP_ENV=production, because that combination stores every lead
# and tells nobody.
NOTIFY_DRIVER=log
# Required when NOTIFY_DRIVER=ses: the owner's mailbox that receives the lead notification.
NOTIFY_TO=
# Required when NOTIFY_DRIVER=ses: the verified SES sending address. Never the visitor's address,
# which would fail SPF/DKIM for this domain and land in spam.
SES_FROM=
AWS_REGION=
# Leave AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY empty to use the ambient AWS credential chain
# (an EC2 instance profile or an EKS pod identity, for example). Set both only when the service
# runs somewhere without an attached role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional. Prefixes the SES subject line, e.g. "[Landing Kit] New lead from Bat", so an owner
# whose inbox receives leads from several sites built on this template can tell them apart. Empty
# is fine: the subject just drops the prefix. Match site.config.ts's `name`.
NOTIFY_SITE_NAME=
