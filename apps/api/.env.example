PORT=3000
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
# Leave PROXY_HEADER empty unless a proxy really sets it. Fiber's c.IP() returns "" when the
# named header is absent, which breaks any limiter keyed on the client IP.
PROXY_HEADER=

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=landing
DB_SSLMODE=disable
