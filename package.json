{
  "name": "@dewsoft/landing-kit",
  "version": "0.3.0",
  "description": "Scaffolds a bilingual (Mongolian + English) landing site: prerendered static HTML, per-locale SEO, and swappable blocks.",
  "keywords": [
    "landing-page",
    "scaffold",
    "boilerplate",
    "bilingual",
    "mongolian",
    "i18n",
    "seo",
    "tanstack-start",
    "react"
  ],
  "type": "module",
  "bin": {
    "landing-kit": "./cli/index.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanasoft1/landing_kit.git"
  },
  "homepage": "https://github.com/tanasoft1/landing_kit#readme",
  "bugs": {
    "url": "https://github.com/tanasoft1/landing_kit/issues"
  },
  "author": "Tanasoft",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "files": [
    "cli",
    "src",
    "scripts",
    "public",
    "README.md",
    "LICENSE",
    "biome.json",
    "components.json"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.29",
    "@tanstack/react-start": "^1.168.46",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "motion": "^13.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "^8.2.1",
    "zod": "^4.4.3"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "fix": "biome check --write .",
    "conventions": "node scripts/check-conventions.mjs",
    "verify": "biome ci . && tsc --noEmit && node scripts/check-conventions.mjs && vite build && node scripts/verify-build.mjs"
  }
}
