{
  "name": "@tanasoftllc/landing-kit",
  "version": "0.4.0",
  "description": "Scaffolds a bilingual (Mongolian + English) landing site: prerendered static HTML, per-locale SEO, and swappable blocks.",
  "keywords": [
    "landing-page",
    "scaffold",
    "boilerplate",
    "bilingual",
    "mongolian",
    "i18n",
    "seo",
    "tanstack-start",
    "react"
  ],
  "packageManager": "pnpm@11.18.0",
  "type": "module",
  "bin": {
    "landing-kit": "./cli/index.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanasoft1/landing_kit.git"
  },
  "homepage": "https://github.com/tanasoft1/landing_kit#readme",
  "bugs": {
    "url": "https://github.com/tanasoft1/landing_kit/issues"
  },
  "author": "Tanasoft",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "files": [
    "cli",
    "apps/web/src",
    "apps/web/scripts",
    "apps/web/public",
    "apps/web/biome.json",
    "apps/web/components.json",
    "apps/web/package.json",
    "apps/web/README.md",
    "apps/api",
    "LICENSE"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.8"
  },
  "scripts": {
    "dev": "pnpm --filter @tanasoftllc/landing-kit-web dev",
    "build": "pnpm --filter @tanasoftllc/landing-kit-web build",
    "typecheck": "pnpm --filter @tanasoftllc/landing-kit-web typecheck",
    "lint": "biome ci . && pnpm --filter @tanasoftllc/landing-kit-web lint",
    "fix": "biome check --write . && pnpm --filter @tanasoftllc/landing-kit-web fix",
    "conventions": "pnpm --filter @tanasoftllc/landing-kit-web conventions",
    "snapshot": "node tools/scaffold-snapshot.mjs check",
    "verify": "pnpm lint && pnpm typecheck && pnpm conventions && pnpm build && pnpm --filter @tanasoftllc/landing-kit-web verify:build && pnpm api:sqlc && pnpm api:build && pnpm api:lint && pnpm api:test && pnpm snapshot",
    "api:sqlc": "cd apps/api && sqlc diff",
    "api:build": "cd apps/api && go build ./...",
    "api:lint": "cd apps/api && golangci-lint run",
    "api:test": "cd apps/api && go test ./..."
  }
}
